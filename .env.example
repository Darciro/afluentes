# Copie para .env.local e preencha com os dados do app web no console do Firebase
# (Configurações do projeto → Seus apps → SDK setup and configuration → Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcional, só para npm run report: caminho da chave de conta de serviço
# (Configurações do projeto → Contas de serviço → Gerar nova chave privada)
FIREBASE_SERVICE_ACCOUNT=

# Área /report (gerar e baixar relatórios). Sem os dois, /report fica desativado
REPORT_USER=
REPORT_PASSWORD=

# Opcional, só para npm start: porta do servidor e fuso das datas do relatório
# PORT=3000
# TZ=America/Sao_Paulo
